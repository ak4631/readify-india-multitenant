DIRECT_URL=""

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Seeded SUPER_ADMIN credentials (used only by prisma/seed.ts)
