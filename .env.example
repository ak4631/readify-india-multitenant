# Postgres connection strings (Supabase project settings -> Database -> Connection string)
DATABASE_URL=""
DIRECT_URL=""
# Actual schema containing the target database's migration history, if ambiguous.
MIGRATION_HISTORY_SCHEMA=""

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Seeded SUPER_ADMIN credentials (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ImageKit (dashboard -> Developer options -> API keys). Server-only, never NEXT_PUBLIC_-prefixed.
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# LocationIQ (locationiq.com dashboard). Server-only -- used from Server Actions
# via src/lib/geocoding.ts, never exposed to the browser bundle.
LOCATIONIQ_API_KEY=""

# Customer API: public project URL/key, used to verify mobile access tokens.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Server-only Razorpay test keys first. Never expose either secret to mobile.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
CHECKOUT_BASE_URL=""
CHECKOUT_SIGNING_SECRET=""
CRON_SECRET=""
