SEED_ADMIN_PASSWORD=""

# ImageKit (dashboard -> Developer options -> API keys). Server-only, never NEXT_PUBLIC_-prefixed.
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# LocationIQ (locationiq.com dashboard). Server-only -- used from Server Actions
# via src/lib/geocoding.ts, never exposed to the browser bundle.
LOCATIONIQ_API_KEY=""
